# Comma-separated Chrome extension origins, for example:
# chrome-extension://YOUR_PUBLISHED_EXTENSION_ID
LEDGERFLOW_ALLOWED_ORIGINS=chrome-extension://YOUR_PUBLISHED_EXTENSION_ID
TRELLO_API_KEY=replace-with-trello-api-key
# Exactly 64 hexadecimal characters (32 bytes) for AES-256-GCM.
LEDGERFLOW_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
