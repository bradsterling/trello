# Comma-separated Chrome extension origins. For this private build, use the
# origin of the one local extension installation.
# chrome-extension://YOUR_EXTENSION_ID
LEDGERFLOW_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# Random, high-entropy bearer credential shared only by this local extension
# config and the backend runtime. Do not commit either value.
LEDGERFLOW_INSTALLATION_SECRET=replace-with-a-random-64-character-secret
TRELLO_API_KEY=replace-with-trello-api-key
# Optional additional guard for the one configured workspace.
TRELLO_WORKSPACE_ID=replace-with-trello-workspace-id
# Exactly 64 hexadecimal characters (32 bytes) for AES-256-GCM.
LEDGERFLOW_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
