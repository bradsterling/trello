{
  "manifest_version": 3,
  "key": "",
  "name": "ledgerflow for Trello & QuickBooks",
  "description": "Match Trello transaction lists, reconcile totals, and transfer split lines to QuickBooks.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "identity",
    "debugger"
  ],
  "host_permissions": [
    "https://*.intuit.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://us-central1-quickbooks-trello-d4fa3.cloudfunctions.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ledgerflow",
    "default_icon": {
      "16": "assets/icons/ledgerflow-16.png",
      "32": "assets/icons/ledgerflow-32.png",
      "48": "assets/icons/ledgerflow-48.png",
      "128": "assets/icons/ledgerflow-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/ledgerflow-16.png",
    "32": "assets/icons/ledgerflow-32.png",
    "48": "assets/icons/ledgerflow-48.png",
    "128": "assets/icons/ledgerflow-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.intuit.com/*"
      ],
      "js": [
        "content/quickbooks-adapter.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
